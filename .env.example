# Copie para .env.local. Valores VITE_* são públicos; nunca coloque segredos neles.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Somente no servidor: chave administrativa para o controle durável de consumo.
SUPABASE_SERVICE_ROLE_KEY=
# Chave ElevenLabs somente no servidor.
ELEVENLABS_API_KEY=
# Opcional: ID de uma voz disponível na sua conta.
ELEVENLABS_DEFAULT_VOICE_ID=
PORT=8787
# Obrigatório na Vercel para preservar os streams JSON/multipart dos uploads.
NODEJS_HELPERS=0
# Inclua o domínio próprio, quando houver; domínios do deploy são reconhecidos.
APP_ORIGINS=
