{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "fluid": true,
  "functions": {
    "api/*.mjs": {
      "maxDuration": 150,
      "includeFiles": "{shared/environments.json,shared/bundled-assets.json,public/audio/**}"
    }
  },
  "rewrites": [
    { "source": "/api/audio/:path*", "destination": "/api/audio?__audio_route=:path*" },
    { "source": "/:path((?!api/|audio/|assets/).*)", "destination": "/index.html" }
  ]
}
